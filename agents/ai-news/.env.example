# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# SMTP settings. For Gmail, use smtp.gmail.com:465 and an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=

# Who receives the digest (comma-separated for several)
MAIL_TO=you@gmail.com

# Optional: override the schedule (cron syntax). Default: every 5 minutes.
# CRON_SCHEDULE=*/5 * * * *
